
record(mbbo, "$(P)$(R)State"){
    field(DESC, "Stop or Start the $(SVC) service")
    field(DTYP, "stream")
    field(OUT, "@svcmgr.proto runCmd($(SVC))")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(ZRST, "stop")
    field(ONST, "start")
    field(TWST, "restart")
    field(SCAN, "Passive")
}

record(mbbi, "$(P)$(R)Status_RBV") {
    field(DESC, "Status of the $(SVC) service")
    field(DTYP, "stream")
    field(INP, "@svcmgr.proto getString(status, $(SVC)) $(PORT)")
    field(SCAN, "1 second")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(FRVL, "4")
    field(ZRST, "Active")
    field(ONST, "Inactive")
    field(TWST, "Activating")
    field(THST, "Deactivating")
    field(FRST, "Failed")
}

